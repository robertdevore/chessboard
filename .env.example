# Demo works with an empty file. For Live, use one of these connection forms.
# CHESSBOARD_TEAM=your-vercel-team-slug
# CHESSBOARD_BOARD_NAME=General
# BOARD_URL=http://127.0.0.1:4100/api/board
# CHESSBOARD_LIVE=1                    # when using an already linked Vercel project
# BOARD_TOKEN=                         # only when your Board requires an explicit server credential

# Optional narrow scope and local storage (outside public/).
# CHESSBOARD_CHANNEL=engineering
# CHESSBOARD_DB=.chessboard/live.sqlite

# Role map keyed by exact stable Board actor IDs from vb actors --json.
# CHESSBOARD_ROLES='{"local:user:YOUR_OS_USER+reviewer":"Reviewer"}'

# Optional absolute path to an existing RunLedger directory containing runs/.
# CHESSBOARD_RUNLEDGER_DIR=/absolute/path/to/.runledger
